# 네이버페이 결제내역 조회를 위한 쿠키
# 추출 방법:
#   1. 브라우저에서 https://pay.naver.com 로그인
#   2. F12 (개발자도구) → 네트워크 탭 선택
#   3. F5로 페이지 새로고침
#   4. 첫 번째 요청 클릭 → Headers → Request Headers → Cookie 값 전체 복사
#   5. 아래에 붙여넣기
NAVER_COOKIE="여기에_쿠키_문자열_붙여넣기"

# 트래블월렛 엑셀 비밀번호 (보통 생년월일 6자리)
TW_PASSWORD="950211"

# 분석 기간 (미설정 시 전체 조회)
# 지원 형식: YYYY-MM-DD, YY-MM-DD, YYYY/MM/DD, YY/MM/DD
#           시간 추가 가능: YYYY-MM-DD HH:MM:SS
START_DATE="2026-02-13"
END_DATE="2026-02-21 23:59:59"
